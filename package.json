{
  "name": "pm-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PM Runtime local-first desktop workspace",
  "engines": { "node": "22.23.2", "npm": "10.9.8" },
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "doctor": "node scripts/doctor.cjs",
    "build": "node scripts/build.cjs",
    "test": "node --test tests/**/*.test.cjs",
    "test:mcp": "node --test tests/mcp.test.cjs",
    "package:win": "electron-builder --win --dir"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.17.5",
    "ajv": "8.17.1",
    "elkjs": "0.9.3",
    "mammoth": "1.10.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.15.21",
    "@types/react": "19.1.2",
    "@types/react-dom": "19.1.2",
    "electron": "38.2.0",
    "electron-builder": "26.0.12",
    "typescript": "5.9.2",
    "vite": "7.1.5",
    "vitest": "3.2.4"
  }
}
